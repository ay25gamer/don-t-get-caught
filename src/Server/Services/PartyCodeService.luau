--!strict
--[[
	PartyCodeService.luau

	Match-only. A private party's short join code (generated by PartyService, Hub-side) only
	ever exists in the Hub's PartyCodes DataStore and the host's TeleportData — nothing about it
	naturally reaches the Match server the host actually lands in, so anyone who wants to invite
	a SECOND friend (beyond the one they shared the code with before teleporting) would have no
	way to see it again. This service reads it once, off whichever player's TeleportData carries
	it (only the host's does — see PartyService.onCreateParty), and broadcasts it to every client
	in this server so it stays visible in the HUD for the whole match. A public-room or Hub-quick
	-join server never has one, so nothing fires there — the HUD simply never shows the label.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = require(ReplicatedStorage:WaitForChild("Shared"))
local Logger = Shared.Logger.new("PartyCodeService")

local PartyCodeAssignedEvent = Shared.Remotes.GetEvent("PartyCodeAssigned")

local PartyCodeService = {}
-- Match-only — a party code only ever means anything inside the private server it named.
PartyCodeService.Modes = { "Match" }

local partyCode: string? = nil

local function tryCaptureFrom(player: Player)
	if partyCode then
		return
	end

	local ok, joinData = pcall(function()
		return player:GetJoinData()
	end)
	if not ok then
		return
	end

	-- GetJoinData()'s TeleportData is arbitrary JSON from the Hub server — typed `any` here
	-- rather than fighting Luau's JSON-value union type, same as MonetizationService treats
	-- receiptInfo as `any` for the same reason (untyped data crossing a server boundary).
	local teleportData = (joinData :: any).TeleportData
	if typeof(teleportData) == "table" and typeof(teleportData.PartyCode) == "string" then
		local code: string = teleportData.PartyCode
		partyCode = code
		Logger:Info(("This server is party %s."):format(code))
	end
end

local function onPlayerAdded(player: Player)
	tryCaptureFrom(player)
	if partyCode then
		PartyCodeAssignedEvent:FireClient(player, partyCode)
	end
end

function PartyCodeService.Start()
	for _, player in ipairs(Players:GetPlayers()) do
		onPlayerAdded(player)
	end
	Players.PlayerAdded:Connect(onPlayerAdded)
end

return PartyCodeService
